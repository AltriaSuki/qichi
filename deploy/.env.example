# 栖迟线上配置模板。复制为 .env 后填写：cp .env.example .env
# .env 已在 .gitignore 中，不要提交。随机串用 `openssl rand -base64 48` 生成。

# ── 开哪些可选服务 ──
# caddy：用这里自带的 Caddy 对外（服务器上已经有 Caddy / Nginx 占着 80、443 时去掉）
# converter：审稿的文档转换（LibreOffice，要多 300–500MB 内存；1GB 内存的服务器去掉，审稿只收 PDF）
COMPOSE_PROFILES=caddy,converter
# 开了 converter 才填；去掉 converter 时留空
CONVERTER_URL=http://converter:3000

# ── 域名 ──
# Caddy 用 DOMAIN 自动申请 HTTPS 证书；域名要先解析到这台 VPS。
# 用 DuckDNS 时：DOMAIN=qichi1.duckdns.org，PUSH_DOMAIN=push.qichi1.duckdns.org（子域名自动解析，不用另加）
DOMAIN=qichi.example.com
PUBLIC_BASE_URL=https://qichi.example.com
# 推送服务器（ntfy）的域名
PUSH_DOMAIN=push.qichi.example.com

# ── 数据库 ──
POSTGRES_DB=qichi
POSTGRES_USER=qichi
POSTGRES_PASSWORD=

# ── 鉴权 ──
# 至少 32 个字符。更换后所有人需要重新登录。
JWT_SECRET=

# ── 日志 ──
LOG_LEVEL=INFO

# ── AI（第 4 阶段起；留空则 App 里的 AI 按钮不可用）──
# AI_PROVIDER：openai-compatible（大多数服务商都兼容）或 anthropic
# 换服务商、换模型只要改 AI_BASE_URL、AI_MODEL，然后 docker compose up -d
# 现在用的模型：gpt-6-sol（2026-09 比较过几个，它最快、质量不输，见 docs/10-ai-assistant.md 第五节）
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_TOKEN_LIMIT=2000000

# ── 推送 ──
# unifiedpush（自建 ntfy）。两台手机没有谷歌服务，FCM 没有实现。
PUSH_PROVIDERS=unifiedpush
