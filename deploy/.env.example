# 栖迟线上配置模板。复制为 .env 后填写：cp .env.example .env
# .env 已在 .gitignore 中，不要提交。随机串用 `openssl rand -base64 48` 生成。

# ── 域名 ──
# Caddy 用 DOMAIN 自动申请 HTTPS 证书；域名要先解析到这台 VPS。
DOMAIN=qichi.example.com
PUBLIC_BASE_URL=https://qichi.example.com

# ── 数据库 ──
POSTGRES_DB=qichi
POSTGRES_USER=qichi
POSTGRES_PASSWORD=

# ── 鉴权 ──
# 至少 32 个字符。更换后所有人需要重新登录。
JWT_SECRET=

# ── 日志 ──
LOG_LEVEL=INFO

# ── AI（第 4 阶段起；留空则 App 里的 AI 按钮不可用）──
# AI_PROVIDER：openai-compatible 或 anthropic
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_TOKEN_LIMIT=2000000

# ── 推送（第 3 阶段起）──
# 逗号分隔：fcm、unifiedpush；留空 = 不推送（App 后台每 15 分钟同步一次）
PUSH_PROVIDERS=
