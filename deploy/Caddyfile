# Caddy 会为 DOMAIN 自动申请并续期 HTTPS 证书（需要 80、443 端口对外开放）。
{$DOMAIN} {
	encode zstd gzip

	# WebSocket（/api/v1/ws）由 reverse_proxy 自动处理。
	reverse_proxy server:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# 访问日志不记查询串（搜索词）和日历订阅地址里的令牌（Q5）；登录令牌 Caddy 本来就遮掉了
	log {
		output stdout
		format filter {
			request>uri regexp (/api/v1/ics/)[^?]*|\?.* ${1}
			wrap console
		}
	}
}

# 推送服务器（ntfy）。DuckDNS 的子域名（push.xxx.duckdns.org）会自动解析到同一台机器。
{$PUSH_DOMAIN} {
	reverse_proxy ntfy:80

	# 网址里就是推送主题（知道它就能收那台手机的推送），不记
	log {
		output stdout
		format filter {
			request>uri delete
			wrap console
		}
	}
}
